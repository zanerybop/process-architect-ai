# Шаблон профиля. Реальный доступ к Яндексу пока НЕ проверен: not_live_verified.
# Перенесите настройки в локальный .env; не коммитьте ключ и не подставляйте чужую модель.
# Источник: https://aistudio.yandex.ru/ru/docs/ai-studio/operations/generation/completions-structured
# Сначала выберите модель, предоставленную организаторами/доступную вашему каталогу.
APP_MODE=live
LLM_PROVIDER_PROFILE=yandex_ai_studio
LLM_API_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_DOCKER_API_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_AUTH_SCHEME=auto
LLM_PROJECT=
LLM_API_KEY=
# Точный URI модели из AI Studio/условий финала, без автоматического выбора.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_REPAIR_ATTEMPTS=2
LLM_MAX_TOKENS=8000
LLM_TOKEN_PARAMETER=max_completion_tokens
# Поддержка json_schema зависит от выбранной модели; json_object задаётся явно при необходимости.
LLM_RESPONSE_FORMAT=json_schema
# auto опускает параметр; конкретная модель может поддерживать другие значения.
LLM_REASONING_EFFORT=auto
