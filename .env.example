# Конфигурация приложения. Скопируйте в .env и заполните локально.
APP_MODE=mock
# openai_compatible или yandex_ai_studio; профиль не означает проверенную live-модель.
LLM_PROVIDER_PROFILE=openai_compatible
# auto: Bearer для совместимого API; Api-Key для профиля Яндекса.
LLM_AUTH_SCHEME=auto
# Необязательный OpenAI-Project (идентификатор каталога в Yandex AI Studio).
LLM_PROJECT=
LLM_API_BASE_URL=
# Для модели на Windows-хосте задайте URL, доступный из Docker API-контейнера.
# Например: http://host.docker.internal:8080/v1
LLM_DOCKER_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_REPAIR_ATTEMPTS=2
LLM_MAX_TOKENS=8000
LLM_TOKEN_PARAMETER=max_completion_tokens
LLM_RESPONSE_FORMAT=json_object
# auto не передаёт параметр модели; для Strata none отключает thinking.
LLM_REASONING_EFFORT=auto
WORKER_URL=http://worker:8081
DATA_DIR=./local_data
# Для текущего localhost HTTP — false; при публикации через HTTPS требуется true.
AUTH_COOKIE_SECURE=false
# Выберите другой порт, если 8080 занят локальным сервером модели.
WEB_PORT=8080
# Ресурсные ограничения фиксированы в коде: описание 20000 символов,
# Python 65536 байт; документный API — 1200 вызовов, 2500 элементов.
# Лимиты прежнего API 1.0: 30 задач, 80 узлов, 5 дорожек, 2 пула.
# Worker: 5 секунд, child 128 MiB.
# LLM_API_KEY не передаётся в frontend/worker и не включается в отчёты.
